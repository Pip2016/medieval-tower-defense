; Engine configuration file.
; Godot 4.2+ Tower Defense - Enterprise Edition

[application]

config/name="Tower Defense - Enterprise Edition"
config/description="Professional tower defense with resource-based data-driven architecture."
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.png"

[autoload]

GameEvents="*res://scripts/autoload/game_events.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

